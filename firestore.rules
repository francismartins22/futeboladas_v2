rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tudo o resto (incluindo os dados antigos em artifacts/futeboladas-v2) fica fechado.
    match /artifacts/futeboladas-v3 {

      function uid() { return request.auth.uid; }
      function signedIn() { return request.auth != null; }
      function groupPath(gid) { return /databases/$(database)/documents/artifacts/futeboladas-v3/groups/$(gid); }
      function groupData(gid) { return get(groupPath(gid)).data; }
      function isMember(gid) { return signedIn() && uid() in groupData(gid).members; }
      function isOwner(gid) { return signedIn() && groupData(gid).ownerId == uid(); }
      function isAdmin(gid) { return isOwner(gid) || (signedIn() && uid() in groupData(gid).get('admins', [])); }
      // Para escritas em batch com a criacao do grupo (o grupo ainda nao existe antes do batch)
      function isAdminAfter(gid) {
        let g = getAfter(groupPath(gid)).data;
        return signedIn() && (g.ownerId == uid() || uid() in g.get('admins', []));
      }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // So muda a chave do proprio utilizador dentro do mapa `field`
      function onlyOwnKey(field) {
        return changed().hasOnly([field])
          && request.resource.data[field].diff(resource.data.get(field, {})).affectedKeys().hasOnly([uid()]);
      }
      // So mexe na propria chave do mapa `field` (o mapa pode ainda nao existir)
      function ownKeyIn(field) {
        return request.resource.data.get(field, {}).diff(resource == null ? {} : resource.data.get(field, {})).affectedKeys().hasOnly([uid()]);
      }
      // Lista de espera: a hora de chegada tem de ser a do servidor (ninguem passa a frente com uma data falsa)
      function goingAtIsNow() {
        return !(uid() in request.resource.data.get('goingAt', {})) || request.resource.data.goingAt[uid()] == request.time;
      }
      function zeroStats() { return request.resource.data.stats == { 'games': 0, 'wins': 0, 'draws': 0, 'losses': 0 }; }

      // ---------------------------- Perfis ----------------------------
      match /users/{userId} {
        allow read, write: if signedIn() && uid() == userId;
      }

      // ---------------------------- Grupos ----------------------------
      match /groups/{gid} {
        // get de um id inexistente e permitido para a app verificar se o nome ja esta ocupado
        allow get: if resource == null || isMember(gid);
        allow list: if signedIn() && uid() in resource.data.members;

        allow create: if signedIn()
          && request.resource.data.ownerId == uid()
          && request.resource.data.members == [uid()]
          && request.resource.data.get('admins', []) == []
          && request.resource.data.inviteCode is string;

        allow update: if
          // dono: tudo menos trocar o dono
          (isOwner(gid) && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.members == resource.data.members)
          // admin: definicoes do grupo
          || (isAdmin(gid) && changed().hasOnly(['settings', 'locationUrl', 'location', 'inviteCode']))
          // membro: sair do grupo (remover-se a si proprio; o dono nao pode sair)
          || (isMember(gid) && !isOwner(gid) && changed().hasOnly(['members'])
            && request.resource.data.members == resource.data.members.removeAll([uid()]))
          // membro: gerar o codigo de convite se o grupo ainda nao tiver (grupos antigos)
          || (isMember(gid) && changed().hasOnly(['inviteCode']) && !('inviteCode' in resource.data)
            && request.resource.data.inviteCode is string);
          // entrar num grupo so pela Cloud Function joinGroup (Admin SDK)

        allow delete: if isOwner(gid);

        // --------------------------- Jogadores ---------------------------
        match /players/{pid} {
          allow read: if isMember(gid);
          allow create: if
            isAdminAfter(gid)
            // o proprio utilizador entra no plantel (so o dono entra como admin)
            || (isMember(gid) && request.resource.data.uid == uid() && zeroStats()
              && (request.resource.data.isAdmin == false || isOwner(gid)))
            // qualquer membro adiciona convidados / jogadores sem conta
            || (isMember(gid) && !('uid' in request.resource.data) && request.resource.data.isAdmin == false && zeroStats());
          allow update: if
            (isOwner(gid))
            || (isAdmin(gid) && !changed().hasAny(['isAdmin']))
            || (isMember(gid) && onlyOwnKey('votes'))
            || (isMember(gid) && resource.data.get('uid', null) == uid() && changed().hasOnly(['name', 'photoUrl', 'left']));
          allow delete: if isAdmin(gid);
        }

        // ------------------------ Peladas jogadas ------------------------
        match /matches/{mid} {
          allow read: if isMember(gid);
          allow create, delete: if isAdmin(gid);
          allow update: if isAdmin(gid)
            // voto MVP: so o proprio voto e so nas 48h seguintes ao jogo
            || (isMember(gid) && onlyOwnKey('mvpVotes') && request.time < resource.data.createdAt + duration.value(48, 'h'));
        }

        // ------------------------------ Chat ------------------------------
        match /messages/{msgId} {
          allow read: if isMember(gid);
          allow create: if isMember(gid) && request.resource.data.uid == uid() && request.resource.data.createdAt == request.time;
        }

        // ------------------------- Proxima pelada -------------------------
        match /schedule/{docId} {
          allow read: if isMember(gid);
          allow create: if isAdmin(gid)
            || (isMember(gid) && request.resource.data.keys().hasOnly(['responses', 'goingAt'])
              && ownKeyIn('responses') && ownKeyIn('goingAt') && goingAtIsNow());
          allow update: if isAdmin(gid)
            || (isMember(gid) && changed().hasOnly(['responses', 'goingAt'])
              && ownKeyIn('responses') && ownKeyIn('goingAt') && goingAtIsNow());
          allow delete: if isAdmin(gid);
        }

        // --------------------------- Liga e treinos ---------------------------
        match /leagueGames/{id} {
          allow read: if isMember(gid);
          allow write: if isAdmin(gid);
        }
        match /trainings/{id} {
          allow read: if isMember(gid);
          allow create, delete: if isAdmin(gid);
          allow update: if isAdmin(gid) || (isMember(gid) && onlyOwnKey('responses'));
        }

        // ---------------------------- Tesouraria ----------------------------
        match /treasury/{period} {
          function ownsPlayer(pid) {
            return get(/databases/$(database)/documents/artifacts/futeboladas-v3/groups/$(gid)/players/$(pid)).data.get('uid', null) == uid();
          }
          // membro inscreve-se / cancela: fixedIds muda exatamente num id, que e o seu proprio jogador
          function ownFixedChange() {
            let before = resource == null ? [] : resource.data.get('fixedIds', []);
            let after = request.resource.data.get('fixedIds', []);
            let diff = after.removeAll(before).concat(before.removeAll(after));
            return diff.size() == 1 && ownsPlayer(diff[0]);
          }
          allow read: if isMember(gid);
          allow create: if isAdmin(gid)
            || (isMember(gid) && request.resource.data.keys().hasOnly(['fixedIds']) && ownFixedChange());
          allow update: if isAdmin(gid)
            || (isMember(gid) && changed().hasOnly(['fixedIds']) && ownFixedChange());
        }
      }
    }
  }
}
